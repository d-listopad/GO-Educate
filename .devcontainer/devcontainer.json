{
  "name": "GO Educate",
  "image": "mcr.microsoft.com/devcontainers/go:1.26-trixie",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go"],
      "settings": {
        "editor.formatOnSave": true,
        "files.autoSave": "afterDelay",
        "go.toolsManagement.autoUpdate": true
      }
    }
  },
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "go version"
}
